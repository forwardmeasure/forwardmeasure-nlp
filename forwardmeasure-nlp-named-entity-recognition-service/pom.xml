<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.forwardmeasure.nlp</groupId>
        <artifactId>forwardmeasure-nlp-parent</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>forwardmeasure-nlp-named-entity-recognition-service</artifactId>
    <packaging>pom</packaging>
    <name>ForwardMeasure Named Entity Recognition Service</name>
    <description>Engine-neutral KServe predictor; GLiNER is the first provider</description>
    <dependencies>
        <!-- provided: only needed to unpack the spec's resources at build time below. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>forwardmeasure-nlp-named-entity-recognition-contracts</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-openapi-spec</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>forwardmeasure-nlp-named-entity-recognition-contracts</artifactId>
                                    <version>${project.version}</version>
                                    <type>jar</type>
                                    <includes>META-INF/openapi/**</includes>
                                    <outputDirectory>${project.build.directory}/unpacked-openapi-spec</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>resolve-python-runtime-versions</id>
                        <phase>generate-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/python-runtime</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/build</directory>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-ner-python-fastapi-server</id>
                        <phase>generate-sources</phase>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <inputSpec>${project.build.directory}/unpacked-openapi-spec/META-INF/openapi/named-entity-recognition-api.yaml</inputSpec>
                            <generatorName>python-fastapi</generatorName>
                            <output>${project.build.directory}/generated-server</output>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <configOptions>
                                <packageName>named_entity_recognition_api</packageName>
                                <projectName>forwardmeasure-named-entity-recognition-api</projectName>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                <disallowAdditionalPropertiesIfNotPresent>true</disallowAdditionalPropertiesIfNotPresent>
                            </configOptions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-ner-python-client</id>
                        <phase>generate-sources</phase>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <inputSpec>${project.build.directory}/unpacked-openapi-spec/META-INF/openapi/named-entity-recognition-api.yaml</inputSpec>
                            <generatorName>python</generatorName>
                            <output>${project.build.directory}/generated-client</output>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <configOptions>
                                <packageName>named_entity_recognition_client</packageName>
                                <projectName>forwardmeasure-named-entity-recognition-client</projectName>
                                <packageVersion>${revision}</packageVersion>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                <disallowAdditionalPropertiesIfNotPresent>true</disallowAdditionalPropertiesIfNotPresent>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>container-image</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.fabric8</groupId>
                        <artifactId>docker-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-ner-image</id>
                                <phase>package</phase>
                                <goals><goal>build</goal></goals>
                            </execution>
                            <!--
                            Was missing entirely - this image only ever built locally, never
                            pushed, no matter what flags were passed, with no error. skipPush
                            (see forwardmeasure-platform's shared pluginManagement) defaults to
                            true; -Dcontainer-image.push=true flips it false.
                            -->
                            <execution>
                                <id>push-ner-image</id>
                                <phase>package</phase>
                                <goals><goal>push</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <images>
                                <image>
                                    <name>${container-image.registry}/${container-image.group}/named-entity-recognition-service:${container-image.tag}</name>
                                    <build>
                                        <contextDir>${project.basedir}</contextDir>
                                        <dockerFile>Dockerfile</dockerFile>
                                        <args>
                                            <PYTHON_RUNTIME_VERSION>${python.runtime.version}</PYTHON_RUNTIME_VERSION>
                                            <PYTHON_RUNTIME_IMAGE_DIGEST>${python.runtime.image.digest}</PYTHON_RUNTIME_IMAGE_DIGEST>
                                            <PYTORCH_VERSION>${pytorch.version}</PYTORCH_VERSION>
                                        </args>
                                    </build>
                                </image>
                            </images>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>container-image-push</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.fabric8</groupId>
                        <artifactId>docker-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>push-ner-image</id>
                                <phase>package</phase>
                                <goals><goal>push</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
