<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.forwardmeasure.platform</groupId>
        <artifactId>forwardmeasure-platform</artifactId>
        <version>1.0.0</version>
        <relativePath>../forwardmeasure-platform/pom.xml</relativePath>
    </parent>

    <groupId>com.forwardmeasure.nlp</groupId>
    <artifactId>forwardmeasure-nlp-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>ForwardMeasure NLP</name>
    <description>Shared, implementation-neutral natural-language processing services and contracts</description>
    <url>https://github.com/forwardmeasure/forwardmeasure-nlp</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/forwardmeasure/forwardmeasure-nlp.git</connection>
        <developerConnection>scm:git:git@github.com:forwardmeasure/forwardmeasure-nlp.git</developerConnection>
        <url>https://github.com/forwardmeasure/forwardmeasure-nlp</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <revision>1.0.0</revision>

        <python.runtime.version>3.12.12</python.runtime.version>
        <python.runtime.image.digest>sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c</python.runtime.image.digest>
        <gliner.version>0.2.28</gliner.version>
        <pytorch.version>2.13.0</pytorch.version>
        <python.fastapi.version>0.141.1</python.fastapi.version>
        <python.pydantic.version>2.13.4</python.pydantic.version>
        <python.uvicorn.version>0.52.1</python.uvicorn.version>
        <python.httpx.version>0.28.1</python.httpx.version>
        <python.pytest.version>9.0.2</python.pytest.version>
        <python.pytest-asyncio.version>1.3.0</python.pytest-asyncio.version>

        <container-image.registry>docker.io</container-image.registry>
        <container-image.group>forwardmeasure</container-image.group>
        <container-image.tag>${revision}</container-image.tag>
        <container-image.push>false</container-image.push>

        <fabric8.docker.version>0.46.0</fabric8.docker.version>
    </properties>

    <modules>
        <module>forwardmeasure-nlp-named-entity-recognition-contracts</module>
        <module>forwardmeasure-nlp-named-entity-recognition-client-java</module>
        <module>forwardmeasure-nlp-named-entity-recognition-client-typescript</module>
        <module>forwardmeasure-nlp-named-entity-recognition-service</module>
        <module>forwardmeasure-nlp-bom</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>forwardmeasure-nlp-named-entity-recognition-contracts</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>forwardmeasure-nlp-named-entity-recognition-client-java</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.openapitools</groupId>
                    <artifactId>openapi-generator-maven-plugin</artifactId>
                    <version>${openapi-generator.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.fabric8</groupId>
                    <artifactId>docker-maven-plugin</artifactId>
                    <version>${fabric8.docker.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion><version>[25,26)</version></requireJavaVersion>
                                <requireMavenVersion><version>[3.9.9,4)</version></requireMavenVersion>
                                <requirePluginVersions>
                                    <unCheckedPluginList>com.forwardmeasure.platform:forwardmeasure-platform-policy-maven-plugin</unCheckedPluginList>
                                </requirePluginVersions>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration>
                    <flattenMode>ossrh</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
